# DataBase on your local machine
# DB_HOST=mysql (local machine) and DB_HOST=your-rds-endpoint (AWS EC2+RDS)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=appuser
DB_USER=appuser
DB_PASSWORD=change-me-strong-password

# Root password only used by the local MySQL container
MYSQL_ROOT_PASSWORD=change-me-root-password

# Backend on your flask secret key
FLASK-SECRET_KEY=change-me-secret-key

# Frontend on your nginx port
PUBLIC_PORT=80
